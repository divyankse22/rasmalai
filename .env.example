# Rasmalai environment template.
# Copy (do not move) this to .env:  cp .env.example .env
# NEVER commit real values — .env is gitignored, this file is not.
#
# Each block is marked with the slice that first needs it, so you only have to
# fill in what the current slice actually uses.

# ---------------------------------------------------------------------------
# Slice 1 — foundation
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Origin of the Next.js app. Used for CORS and for OAuth redirects.
APP_ORIGIN=http://localhost:3000

# Where the browser reaches the backend.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# ---------------------------------------------------------------------------
# Slice 2 — Supabase auth
# ---------------------------------------------------------------------------
# Dashboard: Settings -> API Keys.
# Use the publishable/secret pair, not the legacy anon/service_role JWT keys —
# those are deprecated at the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Elevated privileges - never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# There is deliberately NO JWT secret here. New Supabase projects sign tokens with
# asymmetric keys, so the backend verifies access tokens against the project's public
# key set and no shared secret ever leaves the dashboard:
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Slice 3 — database
# ---------------------------------------------------------------------------
# Dashboard: Connect -> Session pooler.
# Session mode (5432), not transaction mode (6543): the backend is a long-lived
# process on Render, not a serverless function, and the pooler host works over IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

# Supabase signs Postgres with its own private CA, which is not in Node's trust store, so the
# certificate has to be supplied. It is a public certificate, but it is not kept in the repository.
# Download it from the Connect panel, then EITHER save it as supabase/prod-ca.crt (gitignored,
# and the default location) OR set its contents here — newlines may be written as \n.
# SUPABASE_CA_CERT=
# SUPABASE_CA_CERT_PATH=../../supabase/prod-ca.crt
