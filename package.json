{
  "name": "rasmalai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private two-player mini-game platform for permanently paired partners",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev -w @rasmalai/web\" \"npm run dev -w @rasmalai/server\"",
    "dev:web": "npm run dev -w @rasmalai/web",
    "dev:server": "npm run dev -w @rasmalai/server",
    "build": "npm run build -w @rasmalai/server && npm run build -w @rasmalai/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && npm run lint -w @rasmalai/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.include='apps/server/src/**' --coverage.include='packages/*/src/**'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @rasmalai/server",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "docker:server:build": "docker build -f apps/server/Dockerfile -t rasmalai-server .",
    "docker:server:run": "docker run --rm -p 4000:4000 --env-file .env rasmalai-server"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
